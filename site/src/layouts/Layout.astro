---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { getSocialLinks, mediaUrl, type About } from '../lib/strapi';
import { OWNER } from '../lib/site';
import { parseDate, shortDate } from '../lib/dates';

interface Props {
  title: string;
  /** Overrides the `title · name` composition when a page wants the whole thing. */
  fullTitle?: string;
  description?: string;
  /** Absolute or root-relative image for the link preview. Defaults to /og.png. */
  image?: string;
  /** Custom alt description for the Open Graph image. */
  imageAlt?: string;
  /** Open Graph type: website (default) or article. */
  ogType?: 'website' | 'article';
  /** Article metadata when ogType is 'article'. */
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  /** Additional Schema.org JSON-LD entities to merge into the graph. */
  customJsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** The bracketed category and the date of the identifier line. */
  identifier?: { bracket?: string | null; date?: string | null };
  /** When the page's content last changed. Omitted from the page when unknown. */
  revised?: string | Date | null;
}

const {
  title,
  fullTitle: fullTitleProp,
  description = `${OWNER} — ComSci, statistics, machine learning, photography, and a home lab.`,
  image,
  imageAlt = `${OWNER} — machine learning, photography, and a home lab`,
  ogType = 'website',
  articleMeta,
  customJsonLd,
  identifier,
  revised,
} = Astro.props;

// An explicit choice from the header toggle. Without it the stylesheet follows
// the visitor's system setting, so the attribute is left off entirely.
const themeCookie = Astro.cookies.get('theme')?.value;
const theme = themeCookie === 'light' || themeCookie === 'dark' ? themeCookie : undefined;

const revisedDate = parseDate(revised);
const identifierPath = `${(Astro.site ?? Astro.url).host}${Astro.url.pathname}`;
const identifierDate = identifier?.date ?? (revisedDate ? `revised ${shortDate(revisedDate)}` : '');

const fullTitle = fullTitleProp ?? `${title} · ${OWNER}`;
// Crawlers reject relative og:image/og:url — resolve against the configured site.
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image ?? '/og.png', base).href;
const siteUrl = new URL('/', base).href;

// Structured data tying this domain to a person. Both sources are cached
// (about() is memoized per request; social links share strapi.ts's 60s cache),
// and both degrade to null so a Strapi outage can't take the page down.
let about: About | null = null;
let profileUrls: string[] = [];
try {
  about = await Astro.locals.about();
} catch {
  // no-op: Person falls back to name + url only
}
try {
  profileUrls = (await getSocialLinks())
    .filter((link) => !link.url.startsWith('mailto:'))
    .map((link) => link.url);
} catch {
  // no-op: sameAs is simply omitted
}

// mediaUrl() yields the Strapi origin, which in production is the internal
// compose hostname (http://cms:1337) — unreachable by a crawler. Route the
// portrait through /_image so the URL we publish is the public one.
let portrait = '';
const portraitSrc = mediaUrl(about?.portrait);
if (portraitSrc && about?.portrait?.width && about.portrait.height) {
  try {
    const width = Math.min(about.portrait.width, 800);
    const height = Math.round(about.portrait.height * (width / about.portrait.width));
    const optimized = await getImage({ src: portraitSrc, width, height, format: 'webp' });
    portrait = new URL(optimized.src, base).href;
  } catch {
    // no-op: image is simply omitted from the Person node
  }
}
const person = {
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: OWNER,
  url: siteUrl,
  ...(portrait && { image: portrait }),
  ...(about?.email && { email: about.email }),
  ...(about?.tagline && { description: about.tagline }),
  ...(about?.location && { homeLocation: { '@type': 'Place', name: about.location } }),
  ...(profileUrls.length > 0 && { sameAs: profileUrls }),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Muhammadiyah Malang' },
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: OWNER,
      publisher: { '@id': `${siteUrl}#person` },
    },
    ...(customJsonLd
      ? Array.isArray(customJsonLd)
        ? customJsonLd
        : [customJsonLd]
      : []),
  ],
};
// JSON.stringify leaves `</script` intact, so a CMS-authored title could close
// the tag and start markup. Escaping the three characters HTML gives meaning to
// keeps the payload valid JSON while making tag-breakout impossible.
const jsonLdHtml = JSON.stringify(jsonLd)
  .replace(/&/g, '\\u0026')
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e');
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>

    {/* Identity for search engines: which person this domain belongs to. */}
    <script type="application/ld+json" set:html={jsonLdHtml} is:inline />


    {/* Link previews: WhatsApp, Discord, Slack, Telegram all read these. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={OWNER} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      /* Dimensions are only known for the default card — a page-supplied image
         has its own, and lying about them makes previews render blank. */
      !image && (
        <Fragment>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </Fragment>
      )
    }
    <meta property="og:image:alt" content={imageAlt} />
    {
      ogType === 'article' && articleMeta && (
        <Fragment>
          {articleMeta.publishedTime && (
            <meta property="article:published_time" content={articleMeta.publishedTime} />
          )}
          {articleMeta.modifiedTime && (
            <meta property="article:modified_time" content={articleMeta.modifiedTime} />
          )}
          {articleMeta.section && (
            <meta property="article:section" content={articleMeta.section} />
          )}
          {articleMeta.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
          <meta property="article:author" content={OWNER} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Browser chrome matches the page background of the active theme. */}
    {
      theme ? (
        <meta name="theme-color" content={theme === 'light' ? '#fbf1c7' : '#282828'} />
      ) : (
        <Fragment>
          <meta name="theme-color" content="#282828" />
          <meta name="theme-color" content="#fbf1c7" media="(prefers-color-scheme: light)" />
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="pp">
      <div class="sheet">
        <Header />
        <p class="stamp">
          <span>{identifierPath}</span>
          {identifier?.bracket && <span>[{identifier.bracket}]</span>}
          {identifierDate && <span>{identifierDate}</span>}
        </p>
        <main id="main">
          <slot />
        </main>
        <Footer revised={revisedDate} />
      </div>
    </div>
  </body>
</html>
