---
import Layout from '../../layouts/Layout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Abstract from '../../components/Abstract.astro';
import RefList from '../../components/RefList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { latest } from '../../lib/dates';
import { projectRef } from '../../lib/refs';
import { getProjects, type Project } from '../../lib/strapi';

let projects: Project[] = [];
let hadError = false;

try {
  projects = await getProjects();
} catch {
  hadError = true;
}
---

<Layout
  title="Projects"
  description="Random things I have built, newest first."
  revised={latest(projects.map((project) => project.updatedAt))}
>
  <TitleBlock title="Projects" />
  <Abstract>
    Random things I have built, newest first.
  </Abstract>
  {
    hadError || projects.length === 0 ? (
      <EmptyState message="No projects to show right now. Check back once the content server is up." />
    ) : (
      <div class="one">
        <RefList items={projects.map(projectRef)} />
      </div>
    )
  }
</Layout>
