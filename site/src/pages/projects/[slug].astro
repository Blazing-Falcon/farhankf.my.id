---
import { renderMarkdown } from '../../lib/markdown';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Abstract from '../../components/Abstract.astro';
import PaperTable from '../../components/PaperTable.astro';
import RefList, { type RefItem } from '../../components/RefList.astro';
import EmptyState from '../../components/EmptyState.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import { createSlugger } from '../../lib/markdown';
import { difficultyLabel } from '../../lib/refs';
import { getProjectBySlug, mediaUrl, type Project } from '../../lib/strapi';

const { slug } = Astro.params;

let project: Project | null = null;
let hadError = false;

try {
  project = await getProjectBySlug(slug!);
} catch {
  hadError = true;
}

if (hadError) {
  Astro.response.status = 502;
} else if (!project) {
  Astro.response.status = 404;
}

const headingSlug = createSlugger();
const bodyHtml = project?.body ? renderMarkdown(project.body, headingSlug) : '';
const hasBlocks = project?.contentBlocks && project.contentBlocks.length > 0;
// null for anything Date cannot parse, so a malformed CMS date drops the badge
// and the dateCreated field instead of throwing the whole page away.
const finishedAt = project?.finishedAt ? new Date(project.finishedAt) : null;
const finishedIso =
  finishedAt && !Number.isNaN(finishedAt.getTime()) ? finishedAt.toISOString() : null;
const year = finishedIso ? new Date(finishedIso).getFullYear() : null;

const difficulty = difficultyLabel(project?.difficulty);

const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const specification = [
  ...(year ? [{ label: 'Year', value: String(year) }] : []),
  ...(difficulty ? [{ label: 'Status', value: difficulty }] : []),
  ...(project?.stats ?? []).map((stat) => ({ label: capitalize(stat.label), value: stat.value })),
  ...(project?.techStack?.length ? [{ label: 'Stack', value: project.techStack.join(', ') }] : []),
];

const display = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const references: RefItem[] = [
  ...(project?.projectUrl
    ? [{ title: 'Live site', link: { href: project.projectUrl, text: display(project.projectUrl), mono: true } }]
    : []),
  ...(project?.repoUrl
    ? [{ title: 'Repository', link: { href: project.repoUrl, text: display(project.repoUrl), mono: true } }]
    : []),
];

const cover = project?.coverImage;
const gallery = (project?.gallery ?? []).filter((image) => image.width && image.height);
// Subfigures sit three to a row, lettered (a), (b), (c) across rows.
const galleryRows = Array.from({ length: Math.ceil(gallery.length / 3) }, (_, row) =>
  gallery.slice(row * 3, row * 3 + 3)
);
const letter = (index: number) => String.fromCharCode(97 + (index % 26));

const base = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, base).href;
const siteUrl = new URL('/', base).href;

const projectJsonLd = project
  ? {
      '@type': 'SoftwareSourceCode',
      '@id': `${canonicalUrl}#project`,
      name: project.title,
      description: project.summary,
      url: canonicalUrl,
      ...(finishedIso && { dateCreated: finishedIso }),
      ...(project.repoUrl && {
        codeRepository: project.repoUrl,
      }),
      ...(project.projectUrl && {
        sameAs: project.projectUrl,
      }),
      author: {
        '@id': `${siteUrl}#person`,
      },
    }
  : undefined;
---

<Layout
  title={project?.title ?? 'Project not found'}
  description={project?.summary}
  ogType={project ? 'article' : 'website'}
  articleMeta={project ? { publishedTime: finishedIso ?? undefined } : undefined}
  customJsonLd={projectJsonLd}
  identifier={project ? { bracket: difficulty, date: year ? String(year) : null } : undefined}
  revised={project?.updatedAt}
>
  {
    hadError ? (
      <Fragment>
        <TitleBlock title="Project" />
        <EmptyState message="This project is not available right now. Check back once the content server is up." />
      </Fragment>
    ) : !project ? (
      <Fragment>
        <TitleBlock title="404: no such project" author={false} />
        <section class="abs">
          <p class="center">
            No project has this address. It might have been renamed or removed. Return to the{' '}
            <a href="/projects">list of projects</a>.
          </p>
        </section>
      </Fragment>
    ) : (
      <article>
        <TitleBlock title={project.title}>
          {project.difficulty === 'ongoing-saga' && (
            <p class="preprint">
              Preprint. An ongoing saga: details may change while the server keeps running without a
              case.
            </p>
          )}
        </TitleBlock>
        <Abstract>{project.summary}</Abstract>

        <div class="one bd">
          {cover?.width && cover.height && (
            <figure class="fig wide crop">
              <Image
                src={mediaUrl(cover)}
                width={cover.width}
                height={cover.height}
                widths={[768, 1100, 2040]}
                sizes="(max-width: 1100px) 100vw, 1020px"
                alt={cover.alternativeText ?? project.title}
              />
              <figcaption class="capf">{cover.caption || project.title}.</figcaption>
            </figure>
          )}

          {specification.length > 0 && (
            <div class="narrow">
              <PaperTable caption="Specification." rows={specification} />
            </div>
          )}

          {hasBlocks ? (
            <ArticleContent blocks={project.contentBlocks} slug={headingSlug} />
          ) : bodyHtml ? (
            <div class="md" set:html={bodyHtml} />
          ) : null}

          {galleryRows.length > 0 && (
            <Fragment>
              <h2 class="s">Gallery</h2>
              <figure class="fig wide">
                {galleryRows.map((row, rowIndex) => (
                  <div class="jr stack">
                    {row.map((image, i) => (
                      <div style={`flex: ${(image.width! / image.height!).toFixed(3)} 1 0`}>
                        <Image
                          src={mediaUrl(image)}
                          width={image.width!}
                          height={image.height!}
                          widths={[400, 800]}
                          sizes="(max-width: 760px) 92vw, 340px"
                          alt={image.alternativeText ?? project.title}
                        />
                        <p class="sub">
                          ({letter(rowIndex * 3 + i)}){image.caption && ` ${image.caption}`}
                        </p>
                      </div>
                    ))}
                  </div>
                ))}
                <figcaption class="capf">{project.title}, gallery.</figcaption>
              </figure>
            </Fragment>
          )}

          {references.length > 0 && (
            <Fragment>
              <h2 class="s nonum">References</h2>
              <RefList items={references} />
            </Fragment>
          )}
        </div>
      </article>
    )
  }
</Layout>
