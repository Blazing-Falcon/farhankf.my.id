---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Abstract from '../../components/Abstract.astro';
import CategoryKeywords from '../../components/CategoryKeywords.astro';
import EmptyState from '../../components/EmptyState.astro';
import { latest } from '../../lib/dates';
import { aspect, dateRange, justifiedRows, photoPath, plateDetails } from '../../lib/photos';
import {
  getPhotos,
  getPhotoCategories,
  mediaUrl,
  type Photo,
  type PhotoCategory,
} from '../../lib/strapi';

const activeCategory = Astro.url.searchParams.get('category');

let categories: PhotoCategory[] = [];
let photos: Photo[] = [];
let hadError = false;

try {
  const [fetchedCategories, fetchedPhotos] = await Promise.all([
    getPhotoCategories(),
    getPhotos(activeCategory ? { category: activeCategory } : {}),
  ]);
  categories = fetchedCategories;
  photos = fetchedPhotos.filter((photo) => photo.image?.width && photo.image.height);
} catch {
  hadError = true;
}

const rows = justifiedRows(photos, aspect);
const plateNumber = (photo: Photo) => photos.indexOf(photo) + 1;
const sentence = (text: string) => (/[.!?…]$/.test(text.trim()) ? text.trim() : `${text.trim()}.`);
---

<Layout
  title="Photography"
  description="Street, landscape, macro, and astrophotography shot by Farhan Kurnia Febriansyah — plus the occasional cat portrait."
  identifier={photos.length > 0
    ? { bracket: `${photos.length} ${photos.length === 1 ? 'plate' : 'plates'}`, date: dateRange(photos) || null }
    : undefined}
  revised={latest(photos.map((photo) => photo.updatedAt))}
>
  <TitleBlock title="Photography" />
  <Abstract center>
    Sometimes you just need to take ur mind off things
    <CategoryKeywords slot="keywords" base="/photography" categories={categories} active={activeCategory} />
  </Abstract>

  {
    hadError ? (
      <EmptyState message="The photos are not available right now. Check back once the content server is up." />
    ) : photos.length === 0 ? (
      <EmptyState message="No photos in this category yet." />
    ) : (
      <div class="plates">
        {rows.map((row) => (
          <div class:list={['jr', { stack: row.items.length >= 3 }]}>
            {row.items.map((photo) => (
              <div style={`flex: ${aspect(photo).toFixed(3)} 1 0`}>
                <a href={photoPath(photo)}>
                  <Image
                    src={mediaUrl(photo.image)}
                    width={photo.image.width!}
                    height={photo.image.height!}
                    widths={[480, 960, 1400]}
                    sizes="(max-width: 760px) 92vw, 50vw"
                    alt={photo.image.alternativeText ?? photo.title}
                  />
                </a>
                <p class="sub">
                  Plate {plateNumber(photo)}: {sentence(photo.title)}
                  {plateDetails(photo) && ` ${plateDetails(photo)}.`}
                </p>
              </div>
            ))}
            {row.fill > 0 && <div class="fill" style={`flex: ${row.fill.toFixed(3)} 1 0`} />}
          </div>
        ))}
      </div>
    )
  }
</Layout>

<style>
  .plates {
    margin-top: 40px;
  }
</style>
