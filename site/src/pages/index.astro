---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Abstract from '../components/Abstract.astro';
import AuthorFigure from '../components/AuthorFigure.astro';
import RefList from '../components/RefList.astro';
import EmptyState from '../components/EmptyState.astro';
import { latest } from '../lib/dates';
import { aspect, dateRange, photoPath } from '../lib/photos';
import { profileFacts } from '../lib/profileFacts';
import { postRef, projectRef } from '../lib/refs';
import { AFFILIATION } from '../lib/site';
import {
  getProjects,
  getPhotos,
  getLabNotes,
  getBlogPosts,
  getTicker,
  mediaUrl,
  type Project,
  type Photo,
  type About,
  type LabNote,
  type BlogPost,
} from '../lib/strapi';

let about: About | null = null;
let featuredProjects: Project[] = [];
let featuredPhotos: Photo[] = [];
let labNotes: LabNote[] = [];
let latestPosts: BlogPost[] = [];
let hadError = false;

try {
  [about, featuredProjects, featuredPhotos, labNotes, latestPosts] = await Promise.all([
    Astro.locals.about(),
    getProjects({ featuredOnly: true }),
    getPhotos({ featuredOnly: true }),
    getLabNotes(),
    getBlogPosts({ withContent: false }),
  ]);
} catch {
  hadError = true;
}

featuredProjects = featuredProjects.slice(0, 3);
latestPosts = latestPosts.slice(0, 3);

// One wide photo, then the next two side by side.
const plates = featuredPhotos.filter((photo) => photo.image?.width && photo.image.height).slice(0, 3);
const plateRows = [plates.slice(0, 1), plates.slice(1)].filter((row) => row.length > 0);
const letter = (photo: Photo) => String.fromCharCode(97 + plates.indexOf(photo));
// Gear is typed by hand in the CMS, so the same camera appears in more than one spelling.
const gear = [
  ...new Map(plates.filter((p) => p.gear).map((p) => [p.gear!.toLowerCase(), p.gear!])).values(),
];
const platesCaption = ['Selected plates.', [gear.join(', '), dateRange(plates)].filter(Boolean).join(', ')]
  .filter(Boolean)
  .join(' ');

// The keywords are decorative; fall back to the defaults rather than letting
// a missing/unpublished Ticker entry (404) drag the rest of the page down.
const defaultTopics = [
  'STATISTICS',
  'MACHINE LEARNING',
  'PHOTOGRAPHY',
  'HOME LAB',
  'LINUX',
  'OPEN SOURCE',
  'CATS',
  'COFFEE',
  'D&D',
  'DATA VIZ',
  'R',
  'PYTHON',
  'SQL',
];
let topics = defaultTopics;
try {
  const ticker = await getTicker();
  if (ticker?.topics?.length) topics = ticker.topics;
} catch {
  // keep defaults
}
// The CMS stores topics in capitals. Short ones are abbreviations and stay that way.
const keywords = topics.map((topic) => (topic.length <= 3 ? topic : topic.toLowerCase())).join(', ');

const facts = profileFacts(about);
const githubLabel = about?.githubUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');

const revised = latest([
  about?.updatedAt,
  ...featuredProjects.map((project) => project.updatedAt),
  ...latestPosts.map((post) => post.updatedAt),
  ...labNotes.map((note) => note.updatedAt),
  ...plates.map((photo) => photo.updatedAt),
]);
---

<Layout
  title="Home"
  fullTitle="Farhan Kurnia Febriansyah"
  description="Informatics student at Universitas Muhammadiyah Malang. Machine learning pipelines, from-scratch statistics, a Proxmox home lab, and photography."
  identifier={{ bracket: 'stat.ML · cs.LG · astro-ph.IM' }}
  revised={revised}
>
  <TitleBlock title="An Exercise in Self-Archiving" affiliations={[AFFILIATION, about?.location]}>
    {
      about?.githubUrl && (
        <p class="dt">
          <a class="tty" href={about.githubUrl} target="_blank" rel="noreferrer">
            {githubLabel}
          </a>
        </p>
      )
    }
  </TitleBlock>

  <Abstract>
    Hello, I am Farhan 👋 I keep this site as a record of what I make and see. Sometimes I write a
    deep dive, or just share what I think. It is self-hosted and updated as I go. Also, how did you
    get here?
    <Fragment slot="keywords">{keywords}</Fragment>
  </Abstract>

  {
    hadError && (
      <EmptyState message="The content server is not reachable right now. Check back in a moment." />
    )
  }

  <div class="cols">
    <div class="ca">
      <AuthorFigure portrait={about?.portrait} facts={facts} />
    </div>

    <div class="cl">
      {
        featuredProjects.length > 0 && (
          <Fragment>
            <h2 class="s">Featured projects</h2>
            <RefList items={featuredProjects.map(projectRef)} />
            <p class="more">
              See <a href="/projects">all projects</a>.
            </p>
          </Fragment>
        )
      }

      {
        latestPosts.length > 0 && (
          <Fragment>
            <h2 class="s">Latest posts</h2>
            <RefList items={latestPosts.map(postRef)} />
            <p class="more">
              See <a href="/blog">all posts</a>.
            </p>
          </Fragment>
        )
      }

      {
        labNotes.length > 0 && (
          <Fragment>
            <h2 class="s">Lab notes</h2>
            {labNotes.map((note, i) => (
              <p class="note">
                <b>Note {i + 1}</b> ({note.title})<b>.</b> <i>{note.body}</i>
              </p>
            ))}
          </Fragment>
        )
      }
    </div>

    <div class="cr">
      {
        plates.length > 0 && (
          <Fragment>
            <h2 class="s">Photography</h2>
            <div class="bd">
              <p>
                Off-hours photography collection, when i'm away from keyboard. See the{' '}
                <a href="/photography">full gallery</a>.
              </p>
            </div>
            <figure class="fig">
              {plateRows.map((row) => (
                <div class="jr">
                  {row.map((photo) => (
                    <div style={`flex: ${aspect(photo).toFixed(3)} 1 0`}>
                      <a href={photoPath(photo)}>
                        <Image
                          src={mediaUrl(photo.image)}
                          width={photo.image.width!}
                          height={photo.image.height!}
                          widths={[480, 960]}
                          sizes="(max-width: 760px) 92vw, 482px"
                          alt={photo.image.alternativeText ?? photo.title}
                        />
                      </a>
                      <p class="sub">
                        ({letter(photo)}) {photo.title}
                      </p>
                    </div>
                  ))}
                </div>
              ))}
              <figcaption class="capf">{platesCaption}</figcaption>
            </figure>
          </Fragment>
        )
      }
    </div>
  </div>
</Layout>
