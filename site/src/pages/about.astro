---
import { renderMarkdown } from '../lib/markdown';
import Layout from '../layouts/Layout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Abstract from '../components/Abstract.astro';
import AuthorFigure from '../components/AuthorFigure.astro';
import PaperTable from '../components/PaperTable.astro';
import RefList, { type RefItem } from '../components/RefList.astro';
import EmptyState from '../components/EmptyState.astro';
import { profileFacts } from '../lib/profileFacts';
import { AFFILIATION } from '../lib/site';
import { getSocialLinks, type About, type SocialLink } from '../lib/strapi';

let about: About | null = null;
let hadError = false;

try {
  about = await Astro.locals.about();
} catch {
  hadError = true;
}

// The contact list has its own failure mode so a hiccup there can't blank the bio.
let links: SocialLink[] = [];
try {
  links = await getSocialLinks();
} catch {
  // the section is left out
}

const bioHtml = about?.bio ? renderMarkdown(about.bio) : '';
const facts = profileFacts(about);
const skills = (about?.skills ?? []).map((group) => ({
  label: group.group,
  value: group.items.join(', '),
}));
const correspondence: RefItem[] = links.map((link) => ({
  title: link.label,
  link: {
    href: link.url,
    text: link.handle ?? link.url.replace(/^mailto:|^https?:\/\//, ''),
    mono: true,
  },
}));
---

<Layout
  title="About"
  description="Farhan Kurnia Febriansyah, mahasiswa Informatika di Universitas Muhammadiyah Malang. Machine learning, statistika, homelab Proxmox, fotografi, dan beberapa kucing."
  revised={about?.updatedAt}
>
  {
    hadError || !about ? (
      <Fragment>
        <TitleBlock title="About" />
        <EmptyState message="The about page is not available right now. Check back once the content server is up." />
      </Fragment>
    ) : (
      <article>
        <TitleBlock title={about.headline} author={false} affiliations={[AFFILIATION, about.location]} />
        {/* The owner writes the tagline and the bio in Indonesian; the language tag lets the browser hyphenate them. */}
        {about.tagline && <Abstract lang="id">{about.tagline}</Abstract>}

        <div class="one bd">
          <AuthorFigure portrait={about.portrait} facts={facts} />

          {bioHtml && (
            <Fragment>
              <h2 class="s">Biography</h2>
              <div class="md" lang="id" set:html={bioHtml} />
            </Fragment>
          )}

          {skills.length > 0 && (
            <Fragment>
              <h2 class="s">Favorite tools</h2>
              <PaperTable caption="Favorite tools." head={['Area', 'Tools']} rows={skills} />
            </Fragment>
          )}

          {correspondence.length > 0 && (
            <Fragment>
              <h2 class="s nonum">Correspondence</h2>
              <RefList items={correspondence} />
            </Fragment>
          )}
        </div>
      </article>
    )
  }
</Layout>
