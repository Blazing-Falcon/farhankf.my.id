---
import Layout from '../../layouts/Layout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Abstract from '../../components/Abstract.astro';
import EmptyState from '../../components/EmptyState.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import { Image, getImage } from 'astro:assets';
import { longDate, shortDate } from '../../lib/dates';
import { categorySlug } from '../../lib/refs';
import {
  getBlogPostBySlug,
  getBlogPosts,
  mediaUrl,
  SHOW_EXAMPLE_CONTENT,
  type BlogPost,
} from '../../lib/strapi';

const { slug } = Astro.params;

let post: BlogPost | null = null;
let hadError = false;

try {
  post = await getBlogPostBySlug(slug!);
} catch {
  hadError = true;
}

const fallbackPost: BlogPost = {
  id: 1,
  documentId: 'sample-post-1',
  title: 'Building Distributed ML Pipelines on Proxmox',
  slug: 'building-distributed-ml-pipelines-on-proxmox',
  summary: 'A deep dive into setting up high-throughput inference nodes with zero-downtime container updates and local SQLite replication.',
  category: 'engineering',
  featured: true,
  readTime: '6 min read',
  publishedDate: '2026-08-20',
  contentBlocks: [
    {
      id: 1,
      __component: 'article.markdown-text',
      body: `### High-Throughput Inference on Budget Hardware\n\nWhen running machine learning workloads locally, resource utilization efficiency is everything. This architecture outlines the setup for scaling containerized workers on Proxmox VE without incurring cloud egress penalties.\n\nKey advantages:\n- **Isolated memory pools** via LXC containers\n- **Sub-millisecond IPC** across co-located service pods\n- **Automated snapshot failover** using ZFS storage pools\n\n\`\`\`python\nimport torch\nimport torch.nn as nn\n\nclass InferenceWorker(nn.Module):\n    def __init__(self, model_dim=512):\n        super().__init__()\n        self.backbone = nn.TransformerEncoderLayer(d_model=model_dim, nhead=8)\n\n    def forward(self, x):\n        return self.backbone(x)\n\`\`\``,
    },
    {
      id: 2,
      __component: 'article.pdf-document',
      title: 'Cluster Architecture & Benchmark Report',
      description: 'Full hardware spec sheet, network topology diagram, and load test results under synthetic traffic.',
      pdfFile: {
        id: 1,
        documentId: 'doc-1',
        url: '/documents/example-research-paper.pdf',
      },
    },
    {
      id: 3,
      __component: 'article.markdown-text',
      body: `### Lessons Learned & Production Considerations\n\nMonitoring state with Prometheus and lightweight exporter agents revealed that memory thrashing occurs primarily during batch quantization. Enforcing hard swap limits on worker nodes resolved all tail latency spikes.`,
    },
    {
      id: 4,
      __component: 'article.youtube-video',
      title: 'Cluster Monitoring & Live Quantization Demo',
      youtubeUrl: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
      caption: 'Real-time telemetry and throughput graphs under sustained 1,000 req/sec inference workloads.',
    },
  ],
};

// The fixture above is fabricated demo content. Serving it on a CMS outage
// would present it as real, so it is only reachable where seed data is wanted.
const displayPost =
  post ?? (SHOW_EXAMPLE_CONTENT && hadError && slug === fallbackPost.slug ? fallbackPost : null);

if (hadError && !displayPost) {
  Astro.response.status = 502;
} else if (!displayPost) {
  Astro.response.status = 404;
}
const categoryName = typeof displayPost?.category === 'object' && displayPost.category !== null
  ? displayPost.category.name
  : (displayPost?.category ?? 'Article');

const base = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, base).href;
const siteUrl = new URL('/', base).href;

// Returns an ISO timestamp, or undefined for anything Date cannot parse, so a
// malformed CMS date drops one field instead of throwing the page away.
function isoDate(value: string | null | undefined): string | undefined {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
}

const publishedIso = isoDate(displayPost?.publishedDate);
const modifiedIso = isoDate(displayPost?.updatedAt);

// mediaUrl() yields the internal Strapi origin (http://cms:1337) in production,
// which no crawler can reach. /_image serves the same bytes from this origin.
let coverUrl = '';
const coverSrc = mediaUrl(displayPost?.coverImage);
if (coverSrc && displayPost?.coverImage?.width && displayPost.coverImage.height) {
  try {
    const width = Math.min(displayPost.coverImage.width, 1200);
    const height = Math.round(displayPost.coverImage.height * (width / displayPost.coverImage.width));
    const optimized = await getImage({ src: coverSrc, width, height, format: 'webp' });
    coverUrl = new URL(optimized.src, base).href;
  } catch {
    // no-op: image is simply omitted from the BlogPosting node
  }
}

const blogPostJsonLd = displayPost
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonicalUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      headline: displayPost.title,
      description: displayPost.summary,
      ...(coverUrl && { image: coverUrl }),
      ...(publishedIso && { datePublished: publishedIso }),
      ...((modifiedIso ?? publishedIso) && { dateModified: modifiedIso ?? publishedIso }),
      articleSection: categoryName,
      author: {
        '@id': `${siteUrl}#person`,
      },
      publisher: {
        '@id': `${siteUrl}#person`,
      },
    }
  : undefined;

// Neighbours in publication order. The list is the same cached request the
// blog index makes; if it fails, the post simply has no pager.
let older: BlogPost | null = null;
let newer: BlogPost | null = null;
if (post) {
  try {
    const all = await getBlogPosts({ withContent: false });
    const index = all.findIndex((entry) => entry.documentId === post!.documentId);
    if (index !== -1) {
      newer = all[index - 1] ?? null;
      older = all[index + 1] ?? null;
    }
  } catch {
    // no pager
  }
}

const cover = displayPost?.coverImage;
const filterSlug = categorySlug(displayPost?.category);
const hasCategoryPage = typeof displayPost?.category === 'object' && displayPost.category !== null;
const byline = [longDate(publishedIso), displayPost?.readTime].filter(Boolean).join(' · ');
---

<Layout
  title={displayPost?.title ?? 'Post not found'}
  description={displayPost?.summary}
  ogType={displayPost ? 'article' : 'website'}
  articleMeta={
    displayPost
      ? {
          publishedTime: publishedIso,
          modifiedTime: modifiedIso,
          section: categoryName,
        }
      : undefined
  }
  customJsonLd={blogPostJsonLd}
  identifier={displayPost ? { bracket: categoryName, date: shortDate(publishedIso) || null } : undefined}
  revised={displayPost?.updatedAt ?? displayPost?.publishedDate}
>
  {
    hadError && !displayPost ? (
      <Fragment>
        <TitleBlock title="Blog post" />
        <EmptyState message="This blog post is not available right now. Check back once the content server is up." />
      </Fragment>
    ) : !displayPost ? (
      <Fragment>
        <TitleBlock title="404: Article not found" author={false} />
        <section class="abs">
          <p class="center">
            No article has this address. It may have been archived or moved. Return to the{' '}
            <a href="/blog">blog</a>.
          </p>
        </section>
      </Fragment>
    ) : (
      <article>
        <TitleBlock title={displayPost.title}>{byline && <p class="dt">{byline}</p>}</TitleBlock>
        <Abstract>
          {displayPost.summary}
          <Fragment slot="keywords">
            {hasCategoryPage ? (
              <a href={`/blog?category=${filterSlug}`}>{categoryName}</a>
            ) : (
              categoryName
            )}
          </Fragment>
        </Abstract>

        <div class="one bd">
          {cover?.width && cover.height && (
            <figure class="fig">
              <Image
                src={mediaUrl(cover)}
                width={cover.width}
                height={cover.height}
                widths={[640, 960, 1400]}
                sizes="(max-width: 760px) 92vw, 700px"
                alt={cover.alternativeText ?? displayPost.title}
              />
              <figcaption class="capf">{cover.caption || displayPost.title}.</figcaption>
            </figure>
          )}

          {displayPost.contentBlocks && displayPost.contentBlocks.length > 0 ? (
            <ArticleContent blocks={displayPost.contentBlocks} />
          ) : (
            <p>This post has no content yet.</p>
          )}

          {(older || newer) && (
            <nav class="pager" aria-label="Posts">
              <span>
                {older && (
                  <Fragment>
                    ← Older: <a href={`/blog/${older.slug}`}>{older.title}</a>
                  </Fragment>
                )}
              </span>
              <span>
                {newer && (
                  <Fragment>
                    Newer: <a href={`/blog/${newer.slug}`}>{newer.title}</a> →
                  </Fragment>
                )}
              </span>
            </nav>
          )}
        </div>
      </article>
    )
  }
</Layout>
