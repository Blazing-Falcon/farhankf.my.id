---
import Layout from '../../layouts/Layout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Abstract from '../../components/Abstract.astro';
import CategoryKeywords from '../../components/CategoryKeywords.astro';
import RefList from '../../components/RefList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { latest } from '../../lib/dates';
import { categorySlug, postRef } from '../../lib/refs';
import {
  getBlogPosts,
  getBlogCategories,
  SHOW_EXAMPLE_CONTENT,
  type BlogCategory,
  type BlogPost,
} from '../../lib/strapi';

let posts: BlogPost[] = [];
let categories: BlogCategory[] = [];
let hadError = false;

const currentCategory = Astro.url.searchParams.get('category');

try {
  const [fetchedCategories, fetchedPosts] = await Promise.all([
    getBlogCategories(),
    getBlogPosts({ withContent: false, ...(currentCategory ? { category: currentCategory } : {}) }),
  ]);
  categories = fetchedCategories;
  posts = fetchedPosts;
} catch {
  hadError = true;
}

const fallbackCategories: BlogCategory[] = [
  { id: 1, documentId: 'cat-1', name: 'Engineering', slug: 'engineering', order: 1 },
  { id: 2, documentId: 'cat-2', name: 'Design', slug: 'design', order: 2 },
  { id: 3, documentId: 'cat-3', name: 'Data Science', slug: 'data-science', order: 3 },
  { id: 4, documentId: 'cat-4', name: 'Notes', slug: 'notes', order: 4 },
  { id: 5, documentId: 'cat-5', name: 'Cats', slug: 'cats', order: 5 },
];

const displayCategories =
  categories.length > 0 ? categories : SHOW_EXAMPLE_CONTENT ? fallbackCategories : [];

const fallbackPosts: BlogPost[] = [
  {
    id: 1,
    documentId: 'sample-post-1',
    title: 'Building Distributed ML Pipelines on Proxmox',
    slug: 'building-distributed-ml-pipelines-on-proxmox',
    summary: 'A deep dive into setting up high-throughput inference nodes with zero-downtime container updates and local SQLite replication.',
    category: { id: 1, documentId: 'cat-1', name: 'Engineering', slug: 'engineering' },
    featured: true,
    readTime: '6 min read',
    publishedDate: '2026-08-20',
  },
  {
    id: 2,
    documentId: 'sample-post-2',
    title: 'The Unreasonable Effectiveness of Space Mono and Tangerine Accents',
    slug: 'the-unreasonable-effectiveness-of-space-mono',
    summary: 'Notes on typography, brutalist brutalism vs playful neo-brutalism, and designing developer portfolios that do not look like resume templates.',
    category: { id: 2, documentId: 'cat-2', name: 'Design', slug: 'design' },
    featured: false,
    readTime: '4 min read',
    publishedDate: '2026-08-15',
  },
];

// The samples are demo content, so they must answer the active filter the same
// way real posts would rather than appearing under every category.
const displayPosts =
  posts.length > 0
    ? posts
    : hadError && SHOW_EXAMPLE_CONTENT
      ? fallbackPosts.filter(
          (p) => !currentCategory || categorySlug(p.category) === currentCategory
        )
      : [];
---

<Layout
  title="Blog"
  description="Technical essays, architectural breakdowns, UI experiments, and notes on software engineering."
  revised={latest(posts.map((post) => post.updatedAt))}
>
  <TitleBlock title="Blog" />
  <Abstract>
    Technical essays, architectural breakdowns, system design retrospectives, and occasional feline
    observations.
    <CategoryKeywords slot="keywords" base="/blog" categories={displayCategories} active={currentCategory} />
  </Abstract>
  {
    displayPosts.length === 0 ? (
      <EmptyState
        message={
          hadError
            ? 'The blog is not available right now. Check back once the content server is up.'
            : currentCategory
              ? 'No articles in this category yet.'
              : 'Nothing published yet.'
        }
      />
    ) : (
      <div class="one">
        <RefList items={displayPosts.map(postRef)} />
      </div>
    )
  }
</Layout>
