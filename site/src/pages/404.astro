---
import Layout from '../layouts/Layout.astro';
import TitleBlock from '../components/TitleBlock.astro';
---

<Layout title="Page not found">
  <TitleBlock title="Theorem 404" author={false} />
  <div class="one bd theorem">
    <p class="note"><b>Theorem 404.</b> <i>This page does not exist.</i></p>
    <p class="proof"><span><i>Proof.</i> Trivial.</span><span aria-hidden="true">∎</span></p>
    <p class="back">Return to the <a href="/">home page</a>.</p>
  </div>
</Layout>

<style>
  .theorem {
    max-width: 560px;
  }

  .theorem .proof {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    text-indent: 0;
  }

  .theorem .back {
    text-indent: 0;
    margin-top: 1.2em;
  }
</style>
