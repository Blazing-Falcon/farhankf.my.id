---
import Layout from '../layouts/Layout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Abstract from '../components/Abstract.astro';
import RefList, { type RefItem } from '../components/RefList.astro';
import EmptyState from '../components/EmptyState.astro';
import { latest } from '../lib/dates';
import { getSocialLinks, type SocialLink } from '../lib/strapi';

let links: SocialLink[] = [];
let hadError = false;

try {
  links = await getSocialLinks();
} catch {
  hadError = true;
}

const entries: RefItem[] = links.map((link) => ({
  title: link.label,
  link: {
    href: link.url,
    text: link.handle ?? link.url.replace(/^mailto:|^https?:\/\//, ''),
    mono: true,
  },
}));
---

<Layout
  title="Links"
  description="Where to find Farhan Kurnia Febriansyah elsewhere: GitHub, Instagram, Spotify, and email."
  revised={latest(links.map((link) => link.updatedAt))}
>
  <TitleBlock title="Links" />
  <Abstract center>Profiles and contact details.</Abstract>
  {
    hadError || links.length === 0 ? (
      <EmptyState message="The address book is not available right now. Check back once the content server is up." />
    ) : (
      <div class="one">
        <RefList items={entries} />
      </div>
    )
  }
</Layout>
