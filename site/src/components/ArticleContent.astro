---
import { Image } from 'astro:assets';
import { createSlugger, renderMarkdown, type Slugger } from '../lib/markdown';
import {
  mediaUrl,
  pdfUrl,
  publicMediaUrl,
  type ArticleContentBlock,
  type ArticleImageBlock,
  type MarkdownTextBlock,
  type PdfDocumentBlock,
  type YouTubeVideoBlock,
} from '../lib/strapi';
import { youtubeEmbedUrl } from '../lib/youtube';
import PdfViewer from './PdfViewer.astro';

interface Props {
  blocks?: ArticleContentBlock[] | null;
  /** Shared with the page so heading ids stay unique across every block. */
  slug?: Slugger;
}

const { blocks = [], slug = createSlugger() } = Astro.props;
const contentBlocks = blocks ?? [];

// Captions read as sentences, so each part ends with exactly one full stop.
const sentence = (text: string) => (/[.!?…]$/.test(text.trim()) ? text.trim() : `${text.trim()}.`);
---

<div class="article-content bd">
  {
    contentBlocks.map((block) => {
      if (block.__component === 'article.markdown-text') {
        const markdown = block as MarkdownTextBlock;
        return <div class="md" set:html={renderMarkdown(markdown.body, slug)} />;
      }

      if (block.__component === 'article.captioned-image') {
        const imageBlock = block as ArticleImageBlock;
        const image = imageBlock.image;
        return (
          <figure class="fig">
            {image?.width && image.height ? (
              <Image
                src={mediaUrl(image)}
                width={image.width}
                height={image.height}
                widths={[640, 960, 1400]}
                sizes="(max-width: 760px) 92vw, 700px"
                alt={imageBlock.altText}
              />
            ) : image?.url ? (
              <img src={publicMediaUrl(image)} alt={imageBlock.altText} loading="lazy" />
            ) : null}
            <figcaption class="capf">
              {sentence(imageBlock.caption || imageBlock.altText)}
              {imageBlock.source && (
                <Fragment>
                  {' '}
                  Source: {sentence(imageBlock.source)}
                </Fragment>
              )}
            </figcaption>
          </figure>
        );
      }

      if (block.__component === 'article.pdf-document') {
        const pdfBlock = block as PdfDocumentBlock;
        const source = pdfUrl(pdfBlock.pdfFile);
        if (!source) return null;
        return (
          <figure class="fig">
            <PdfViewer source={source} title={pdfBlock.title} />
            <figcaption class="capf">
              {sentence(pdfBlock.title)}
              {pdfBlock.description && (
                <Fragment>
                  {' '}
                  {sentence(pdfBlock.description)}
                </Fragment>
              )}{' '}
              <a href={source} target="_blank" rel="noreferrer">
                Open or download the PDF
              </a>
              .
            </figcaption>
          </figure>
        );
      }

      if (block.__component === 'article.youtube-video') {
        const videoBlock = block as YouTubeVideoBlock;
        const source = youtubeEmbedUrl(videoBlock.youtubeUrl);
        if (!source) return null;
        return (
          <figure class="fig">
            <div class="video-frame">
              <iframe
                src={source}
                title={`YouTube Video: ${videoBlock.title}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
            <figcaption class="capf">
              {sentence(videoBlock.title)}
              {videoBlock.caption && (
                <Fragment>
                  {' '}
                  {sentence(videoBlock.caption)}
                </Fragment>
              )}{' '}
              <a href={videoBlock.youtubeUrl} target="_blank" rel="noreferrer">
                Watch on YouTube
              </a>
              .
            </figcaption>
          </figure>
        );
      }

      return null;
    })
  }
</div>

<style>
  .video-frame {
    aspect-ratio: 16 / 9;
    background: var(--bg1);
  }

  .video-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
