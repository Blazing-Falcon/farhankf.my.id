---
interface Props {
  source: string;
  title: string;
}

const { source, title } = Astro.props;
---

<div class="pdf-viewer-shell" data-pdf-viewer data-source={source} data-title={title}>
  <div class="pdf-canvas-wrapper">
    <canvas class="pdf-canvas"></canvas>
    <div class="pdf-loading-indicator">Loading document preview...</div>
  </div>
  <div class="pdf-viewer-toolbar">
    <button class="pdf-prev" type="button" aria-label="Previous page" disabled>← Previous</button>
    <span class="pdf-page-indicator" aria-live="polite">
      Page <span class="pdf-current-page">1</span> of <span class="pdf-total-pages">-</span>
    </span>
    <button class="pdf-next" type="button" aria-label="Next page" disabled>Next →</button>
  </div>
</div>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  // ?url makes Vite emit the worker as its own asset and hand back the hashed
  // URL. new URL(<bare specifier>, import.meta.url) is left untouched by the
  // bundler and resolves against the chunk path, which 404s.
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;

  function initPdfViewers() {
    const shells = document.querySelectorAll<HTMLElement>('[data-pdf-viewer]');
    shells.forEach((shell) => {
      if (shell.dataset.initialized === 'true') return;
      shell.dataset.initialized = 'true';

      const source = shell.dataset.source;
      if (!source) return;

      const canvas = shell.querySelector<HTMLCanvasElement>('.pdf-canvas');
      const loader = shell.querySelector<HTMLElement>('.pdf-loading-indicator');
      const prevBtn = shell.querySelector<HTMLButtonElement>('.pdf-prev');
      const nextBtn = shell.querySelector<HTMLButtonElement>('.pdf-next');
      const curPageSpan = shell.querySelector<HTMLElement>('.pdf-current-page');
      const totalPagesSpan = shell.querySelector<HTMLElement>('.pdf-total-pages');

      if (!canvas || !prevBtn || !nextBtn || !curPageSpan || !totalPagesSpan) return;

      let pdfDoc: any = null;
      let pageNum = 1;
      let pageRendering = false;
      let pageNumPending: number | null = null;

      function finishRender() {
        pageRendering = false;
        if (pageNumPending !== null) {
          const next = pageNumPending;
          pageNumPending = null;
          renderPage(next);
        }
      }

      function renderPage(num: number) {
        pageRendering = true;

        pdfDoc
          .getPage(num)
          .then((page: any) => {
            const wrapper = canvas!.parentElement;
            const containerWidth = wrapper ? wrapper.clientWidth - 32 : 800;
            const viewport = page.getViewport({ scale: 1 });
            const scale = Math.min(1.5, Math.max(0.6, containerWidth / viewport.width));
            const scaledViewport = page.getViewport({ scale });

            const context = canvas!.getContext('2d');
            if (!context) return;

            // The backing store is sized in device pixels and scaled back down
            // with CSS, so the page stays sharp on high-density screens.
            const ratio = window.devicePixelRatio || 1;
            canvas!.width = Math.floor(scaledViewport.width * ratio);
            canvas!.height = Math.floor(scaledViewport.height * ratio);
            canvas!.style.width = `${scaledViewport.width}px`;
            canvas!.style.height = `${scaledViewport.height}px`;
            canvas!.setAttribute('aria-label', `${shell.dataset.title ?? 'Document'}, page ${num}`);

            return page
              .render({
                canvasContext: context,
                viewport: scaledViewport,
                transform: ratio === 1 ? undefined : [ratio, 0, 0, ratio, 0, 0],
              })
              .promise.then(() => {
                if (loader) loader.style.display = 'none';
              });
          })
          .catch((err: unknown) => {
            console.error('Failed to render PDF page:', err);
            if (loader) {
              loader.style.display = '';
              loader.textContent = 'This page could not be rendered.';
            }
          })
          .finally(finishRender);

        curPageSpan!.textContent = String(num);
        prevBtn!.disabled = num <= 1;
        nextBtn!.disabled = !pdfDoc || num >= pdfDoc.numPages;
      }

      function queueRenderPage(num: number) {
        if (pageRendering) {
          pageNumPending = num;
        } else {
          renderPage(num);
        }
      }

      prevBtn.addEventListener('click', () => {
        if (pageNum <= 1) return;
        pageNum--;
        queueRenderPage(pageNum);
      });

      nextBtn.addEventListener('click', () => {
        if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
        pageNum++;
        queueRenderPage(pageNum);
      });

      pdfjsLib
        .getDocument(source)
        .promise.then((doc) => {
          pdfDoc = doc;
          totalPagesSpan.textContent = String(doc.numPages);
          renderPage(pageNum);
        })
        .catch((err) => {
          console.error('Failed to load PDF document:', err);
          if (loader) {
            loader.textContent = 'Preview unavailable. Use the button above to view or download the file.';
          }
        });
    });
  }

  initPdfViewers();
  document.addEventListener('astro:page-load', initPdfViewers);
</script>

<style>
  .pdf-canvas-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 200px;
    padding: 16px;
    background: var(--bg1);
    border-top: 1px solid var(--bg3);
    border-bottom: 1px solid var(--bg3);
    overflow-x: auto;
  }

  .pdf-canvas {
    display: block;
    max-width: 100%;
  }

  .pdf-loading-indicator {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    font-size: 17px;
  }

  .pdf-viewer-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 22px;
    margin-top: 8px;
    font-size: 17px;
  }

  .pdf-viewer-toolbar button {
    background: none;
    border: 0;
    padding: 4px 0;
    color: var(--orange);
    cursor: pointer;
  }

  .pdf-viewer-toolbar button:hover:not(:disabled) {
    text-decoration: underline;
  }

  .pdf-viewer-toolbar button:disabled {
    color: var(--mute);
    cursor: default;
  }
</style>
