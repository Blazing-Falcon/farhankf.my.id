---
import { longDate } from '../lib/dates';

interface Props {
  revised?: Date | null;
}

const { revised } = Astro.props;

let githubUrl: string | null = null;
try {
  githubUrl = (await Astro.locals.about())?.githubUrl ?? null;
} catch {
  // Strapi may be unavailable; the footer keeps its internal links.
}
---

<footer class="fn">
  <p>
    <sup>*</sup> Built with Astro + Strapi, self-hosted on Proxmox.
    {revised && <Fragment>This page was last revised on {longDate(revised)}.</Fragment>}
  </p>
  <nav aria-label="Footer">
    <a href="/about">About the author</a>
    <a href="/changes">Revision history</a>
    <a href="/random" rel="nofollow">Random page</a>
    <a href="/links">Links</a>
    {githubUrl && <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>}
  </nav>
</footer>
