---
import { SITE_NAME } from '../lib/site';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/photography', label: 'Photography' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === currentPath || (href !== '/' && currentPath.startsWith(href));
---

<header class="rh">
  <a class="wm" href="/">{SITE_NAME}</a>
  <nav aria-label="Main">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} data-astro-prefetch>
          {item.label}
        </a>
      ))
    }
  </nav>
  <button type="button" id="theme-toggle" title="Switch colour theme">
    <span class="to-light">Light</span><span class="to-dark">Dark</span>
  </button>
</header>

<script>
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : !matchMedia('(prefers-color-scheme: light)').matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    // The server reads this on the next request and renders the page in the
    // chosen theme, so there is no flash of the other one.
    document.cookie = `theme=${next}; Path=/; Max-Age=31536000; SameSite=Lax`;
  });
</script>
